# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Game run directories (worlds, logs, options, downloaded state)
run/

# The SDK Maven repository publishSdk fills and the website build copies to /maven/ (ADR-0008); it keeps
# every published version, so clean does not touch it
/.plexus/

# IntelliJ IDEA — shared run configurations live in .run/
.idea/
*.iml
out/

# Node packages (docs site, local browser tools)
node_modules/

# Claude Code personal settings
.claude/settings.local.json
skills-lock.json
.claude/skills/*
!.claude/skills/plexus-*

# OS / secrets
.DS_Store
Thumbs.db
.env
*.env

# Hand-copied Minecraft files for new versions (never committed); only the README is tracked
/MinecraftFiles/*
!/MinecraftFiles/README.md

# Claude Code agent worktrees
.claude/worktrees/

# Claude Code session logs (local only, may hold personal paths); only the README is tracked
/.claude/session-logs/*
!/.claude/session-logs/README.md

# Playwright MCP console logs and page snapshots (local only)
/.playwright-mcp/

# graphify knowledge graph of this repository (local only)
/graphify-out/

# Python bytecode cache
__pycache__/

# Not part of the public repository (ADR-0028)
/site/
/.claude/
/CLAUDE.md
/AGENTS.md
/docs/
/examples/
/test-mods/
/MinecraftFiles/
/tools/
/plexus-bootstrap/compat/
/.run/
# Only the exported workflows and release scripts are tracked; the rest of .github/ stays private.
/.github/*
!/.github/scripts/
/.github/scripts/*
!/.github/workflows/
/.github/workflows/*
!/.github/scripts/check-release-changes.py
!/.github/scripts/installer-minecraft-versions.py
!/.github/scripts/release-notes.py
!/.github/workflows/ci.yml
!/.github/workflows/release.yml
